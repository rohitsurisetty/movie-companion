# Copy to frontend/.env for local `npx expo start`. EAS builds read these from eas.json instead.
EXPO_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app
# Google Cloud Console > Credentials > OAuth 2.0 Client IDs > the *Web application* client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
