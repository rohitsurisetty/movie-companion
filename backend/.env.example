# Copy to backend/.env for local runs; on Railway/Render paste these as service variables.

# ---- Core ----
APP_ENV=production
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=film_companion
# Origins allowed for the admin dashboard / web preview (the Android app needs no CORS)
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGIN_REGEX=

# ---- Login ----
# Google Sign-In: the WEB OAuth client ID (same value as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_OAUTH_CLIENT_IDS=1234567890-xxxx.apps.googleusercontent.com
# Phone OTP delivery: msg91 | twilio | console (dev only — codes are NOT delivered)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SESSION_TTL_DAYS=30
# Fixed-code numbers for Google Play review / QA (no SMS sent): +91XXXXXXXXXX:123456,...
TEST_OTP_NUMBERS=

# ---- Admin dashboard ----
ADMIN_USERNAME=admin
# bcrypt hash: python -c "import bcrypt;print(bcrypt.hashpw(b'your-strong-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# ---- AI & media APIs ----
OPENAI_API_KEY=
# gpt-4o-mini: tested default, no announced shutdown. Reasoning models (gpt-5.x) also work.
LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MODEL_MATCHING=gpt-4o-mini
TMDB_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ---- Supabase (analytics copy + photo storage; service role key, server-side only) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Demo / mock behaviour (set all to false for a real public launch) ----
MOCK_FEED_PROFILES=true
MOCK_FEED_ONLY=false
MOCK_SEED_CHATS=true
MOCK_BOT_REPLIES=true
ENABLE_DEV_ROUTES=false
